# Configuração do app Web no Firebase.
# Copie este arquivo para .env.local (fora do git) e preencha com o objeto
# firebaseConfig de: console do Firebase → Configurações do projeto → Seus apps → app Web.
#
#   firebaseConfig.apiKey     → VITE_FIREBASE_API_KEY
#   firebaseConfig.authDomain → VITE_FIREBASE_AUTH_DOMAIN
#   firebaseConfig.projectId  → VITE_FIREBASE_PROJECT_ID
#   firebaseConfig.appId      → VITE_FIREBASE_APP_ID
#
# Os demais campos do objeto (storageBucket, messagingSenderId, measurementId)
# não são usados pelo painel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
